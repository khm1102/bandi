# dev(로컬 개발 기본)/prod 프로파일 DB 접속값 — 로컬은 docker compose의 팀 공통 더미값 그대로
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=bandi
DB_PASSWORD=bandi1234

# MinIO 로컬 개발 더미값 — 실제 운영 자격증명 커밋 금지
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=bandi-root
MINIO_ROOT_PASSWORD=bandi-minio-root-dev
MINIO_ACCESS_KEY=bandi
MINIO_SECRET_KEY=bandi-minio-dev
MINIO_PRIVATE_BUCKET=bandi-private
MINIO_PUBLIC_BUCKET=bandi-public
MINIO_MAX_UPLOAD_BYTES=524288000
MINIO_MAX_UPLOAD_SIZE=500MB
MINIO_MAX_REQUEST_SIZE=501MB
MINIO_PRIVATE_URL_LIFETIME=300s

# 관람 신청 개인정보 보호 로컬 개발 더미값 — 운영 키는 환경변수로 별도 관리
RESERVATION_ACTIVE_KEY_VERSION=1
RESERVATION_ENCRYPTION_KEY_V1_BASE64=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
RESERVATION_HMAC_KEY_BASE64=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=
RESERVATION_PERSONAL_DATA_RETENTION=90d
