# dev(로컬 개발 기본)/prod 프로파일 DB 접속값 — 로컬은 docker compose의 팀 공통 더미값 그대로
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=bandi
DB_PASSWORD=bandi1234

# MinIO 로컬 개발 더미값 — 실제 운영 자격증명 커밋 금지
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=bandi
MINIO_SECRET_KEY=bandi-minio-dev
