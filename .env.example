# dev(로컬 개발 기본)/prod 프로파일 DB 접속값 — 로컬은 docker compose의 팀 공통 더미값 그대로
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=bandi
DB_PASSWORD=bandi1234

# 파일 저장 경로 — 로컬 기본값은 /tmp, 운영에서는 /data/bandi 영구 볼륨으로 교체한다.
# 운영 경로는 배포 전에 만들고 실행 계정의 소유권·권한을 설정한다.
FILE_STORAGE_ROOT=/tmp
FILE_STORAGE_MAX_UPLOAD_BYTES=524288000
FILE_STORAGE_MAX_UPLOAD_SIZE=500MB
FILE_STORAGE_MAX_REQUEST_SIZE=501MB

# 프로필 사진 퇴역 재시도 실행 모드 — 운영 명령에서만 APPLY로 설정한다.
PROFILE_PHOTO_RETIREMENT_MODE=DISABLED

# 자료 링크 카드 대표 이미지 퇴역 재시도 실행 모드 — 운영 명령에서만 APPLY로 설정한다.
RESOURCE_LINK_PREVIEW_RETIREMENT_MODE=DISABLED

# 팀 공유 테스트 서버의 Docker Compose에서만 사용한다. 실제 토큰은 .env.test에만 둔다.
CLOUDFLARE_TUNNEL_TOKEN=
BANDI_FILE_STORAGE_HOST_PATH=/data/bandi
