<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %>
<t:layout title="자료" active="resources" role="${role}" scriptPath="resources/detail"><jsp:attribute name="css"><link rel="stylesheet" href="<c:url value='/css/notice/markdown.css'/>"></jsp:attribute><jsp:body><article class="rounded-lg border bg-card p-5 md:p-8" data-resource-detail><h1 class="text-2xl font-black" data-resource-title></h1><p class="mt-3 text-xs text-muted-foreground" data-resource-meta></p><div class="markdown-content mt-7" data-resource-body></div><section class="mt-8 border-t pt-5"><h2 class="text-sm font-extrabold">첨부 파일</h2><ul class="mt-3 space-y-2" data-resource-files></ul></section><div class="mt-8 flex flex-wrap gap-2 border-t pt-5"><t:button variant="outline" href="/resources">목록으로</t:button><button id="resourceShareButton" type="button" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border bg-card px-4 text-sm font-bold hover:bg-secondary hidden" data-share-button data-share-revoke-target="#resourceShareRevoke"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>공유</button><button id="resourceShareRevoke" type="button" class="hidden inline-flex min-h-11 items-center justify-center rounded-md border px-4 text-sm font-bold text-destructive hover:bg-destructive-soft" data-share-revoke data-share-button-target="#resourceShareButton">공유 중단</button><a class="hidden" data-resource-edit>자료 수정</a><button class="hidden" type="button" data-resource-delete data-confirm="이 자료를 삭제하면 목록과 상세, 첨부 다운로드에서 숨겨집니다." data-confirm-action="자료 삭제">자료 삭제</button></div></article></jsp:body></t:layout>
