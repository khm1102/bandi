<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" trimDirectiveWhitespaces="true" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %>
<t:layout title="자료실" active="resources" role="${role}" scriptPath="resources/list"><jsp:attribute name="css"><link rel="stylesheet" href="<c:url value='/css/notice/markdown.css'/>"></jsp:attribute><jsp:body>
<t:pageHead title="자료실" description="동아리에서 함께 보는 자료를 모아 둡니다."><t:button href="/resources/write">자료 작성</t:button></t:pageHead>
<label class="sr-only" for="resourceSearch">자료 검색</label><input id="resourceSearch" data-resource-search class="h-11 w-full rounded-md border bg-card px-3 text-sm" placeholder="제목, 내용, 작성자로 검색">
<div class="mt-5 grid gap-4 lg:grid-cols-2" data-resource-list></div><section class="mt-5 hidden rounded-lg border bg-card p-8 text-center" data-resource-empty><b data-resource-state-title>자료를 불러오는 중입니다</b><p class="mt-2 text-sm text-muted-foreground" data-resource-state-message></p></section><t:pagination id="resourcePagination" label="자료 목록 페이지"/>
<template data-resource-card-template><article class="overflow-hidden rounded-lg border bg-card"><div class="flex min-h-44"><div class="w-40 shrink-0 bg-secondary"><img class="hidden h-full w-full object-cover" data-resource-cover alt=""></div><div class="min-w-0 flex-1 p-5"><h2 class="truncate text-lg font-extrabold" data-resource-title></h2><p class="mt-2 line-clamp-2 text-sm text-muted-foreground" data-resource-summary></p><p class="mt-4 text-xs text-muted-foreground" data-resource-meta></p><a class="mt-4 inline-flex min-h-11 items-center rounded-md border px-3 text-sm font-bold hover:bg-secondary" data-resource-detail>상세 보기</a></div></div></article></template>
</jsp:body></t:layout>
