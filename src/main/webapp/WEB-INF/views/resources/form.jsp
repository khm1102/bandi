<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" trimDirectiveWhitespaces="true" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %>
<t:layout title="자료 작성" active="resources" role="${role}" scriptPath="resources/form"><jsp:attribute name="css"><link rel="stylesheet" href="<c:url value='/css/notice/markdown.css'/>"></jsp:attribute><jsp:body>
<t:pageHead title="자료 작성" description="내용과 파일을 함께 정리해 동아리 멤버에게 공유하세요."><t:button variant="outline" href="/resources">목록으로</t:button></t:pageHead>
<form data-resource-form data-resource-id="" class="space-y-6"><div><label class="mb-2 block text-sm font-bold" for="resourceTitle">제목</label><input id="resourceTitle" data-resource-title class="h-12 w-full rounded-md border bg-card px-4" maxlength="200" required></div><section class="border-t pt-6"><div class="flex items-center justify-between"><h2 class="text-lg font-extrabold">본문</h2><div class="inline-flex rounded-md border p-1"><button type="button" class="min-h-9 rounded px-3 text-sm font-bold" data-resource-tab="write">작성</button><button type="button" class="min-h-9 rounded px-3 text-sm font-bold" data-resource-tab="preview">미리보기</button></div></div><div class="mt-3" data-resource-panel="write"><div class="flex flex-wrap gap-1 rounded-t-md border bg-secondary p-2"><button type="button" data-markdown="bold">B</button><button type="button" data-markdown="heading">H1</button><button type="button" data-markdown="list">목록</button><button type="button" data-markdown="quote">인용</button><button type="button" data-markdown="code">코드</button><button type="button" data-markdown="link">링크</button><button type="button" data-markdown="table">표</button><button type="button" data-markdown="image">이미지</button></div><textarea data-resource-body data-resource-drop-zone class="min-h-[30rem] w-full rounded-b-md border bg-card p-4 font-mono text-sm" required placeholder="# 자료 제목\n\n단독 HTTPS URL은 저장 후 링크 카드로 보여요."></textarea></div><div class="hidden rounded-md border bg-card p-5" data-resource-panel="preview"><div class="markdown-content" data-resource-preview></div></div></section><section class="border-t pt-6"><div class="flex items-center justify-between"><div><h2 class="text-lg font-extrabold">첨부 파일</h2><p class="mt-1 text-xs text-muted-foreground">파일을 끌어놓거나 선택해 첨부하세요. 본문 이미지는 이미지 버튼이나 편집기 드롭으로 함께 추가돼요.</p></div><label class="inline-flex min-h-11 cursor-pointer items-center rounded-md border px-4 text-sm font-bold">파일 첨부<input class="sr-only" type="file" multiple data-resource-files></label></div><ul class="mt-4 space-y-2" data-resource-file-list></ul></section><p class="hidden text-sm text-destructive" data-resource-error></p><div class="flex justify-end gap-2 border-t pt-5"><t:button variant="outline" href="/resources">취소</t:button><t:button type="submit">자료 저장</t:button></div></form>
</jsp:body></t:layout>
