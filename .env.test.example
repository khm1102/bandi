# 팀 공유 테스트 서버 전용 값입니다. 실제 서버에서는 이 파일을 /etc/bandi/.env.test로 복사해 사용합니다.
# /etc/bandi/.env.test의 실제 값은 Git에 커밋하지 않습니다.

MYSQL_ROOT_PASSWORD=bandi1234
MYSQL_DATABASE=bandi
DB_USERNAME=bandi
DB_PASSWORD=bandi1234

# 서버에서 MySQL을 외부 테스트 도구로 조회해야 할 때만 LAN IP로 변경합니다.
MYSQL_HOST_BIND_ADDRESS=127.0.0.1

# 호스트의 영구 파일 저장 경로입니다. 컨테이너에는 /data/bandi로 마운트됩니다.
BANDI_FILE_STORAGE_HOST_PATH=/data/bandi
FILE_STORAGE_MAX_UPLOAD_BYTES=524288000
FILE_STORAGE_MAX_UPLOAD_SIZE=500MB
FILE_STORAGE_MAX_REQUEST_SIZE=501MB
